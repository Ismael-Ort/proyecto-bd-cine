<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Pagina: Salas (tabla `sala`). La tabla `butaca` todavia no se administra
    desde aqui (no se crea SalaBD/Control para eso todavia).

    Sala: nombre_sala, capacidad, estado (ACTIVA/INACTIVA).

    "Filas" x "Butacas por fila" no se guardan como tal: solo sirven para
    calcular la capacidad (filas x butacas por fila) al presionar
    "Generar butacas". Por eso el campo Capacidad no se puede escribir a
    mano (editable="false").

    No hay boton de eliminar sala a proposito: su disponibilidad se maneja
    con el Estado (ACTIVA/INACTIVA), nunca se borra una sala.
-->

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cine.SalaControl" spacing="24" styleClass="main-content" visible="false" managed="false">
    <padding>
        <Insets bottom="36" left="40" right="40" top="36" />
    </padding>

    <VBox spacing="4" styleClass="page-header">
        <Label styleClass="page-title" text="Salas y butacas" />
        <Label styleClass="page-subtitle" text="Configuracion fisica de las salas del cine" />
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="18" styleClass="seat-legend">
        <HBox alignment="CENTER_LEFT" spacing="6">
            <Region styleClass="legend-dot, legend-dot-regular" />
            <Label styleClass="legend-text" text="Activa" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="6">
            <Region styleClass="legend-dot, legend-dot-inactiva" />
            <Label styleClass="legend-text" text="Inactiva" />
        </HBox>
    </HBox>

    <HBox alignment="TOP_LEFT" spacing="24" styleClass="salas-layout">
        <VBox fx:id="salaForm" maxWidth="320" minWidth="300" spacing="16" styleClass="form-card" HBox.hgrow="NEVER">
            <Label fx:id="lblSalaFormTitulo" styleClass="panel-title" text="Nueva sala" />

            <VBox spacing="8">
                <Label styleClass="form-label" text="Nombre" />
                <TextField fx:id="txtSalaNombre" promptText="Ej: Sala 3" styleClass="form-input" />
            </VBox>

            <VBox spacing="8">
                <Label styleClass="form-label" text="Capacidad" />
                <TextField fx:id="txtSalaCapacidad" promptText="48" styleClass="form-input" editable="false" />
            </VBox>

            <VBox spacing="8">
                <Label styleClass="form-label" text="Estado" />
                <ComboBox fx:id="cmbSalaEstado" maxWidth="Infinity" styleClass="form-input">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="ACTIVA" />
                            <String fx:value="INACTIVA" />
                        </FXCollections>
                    </items>
                </ComboBox>
            </VBox>

            <Label styleClass="form-section-label" text="Generar butacas (fila x numero)" />

            <HBox spacing="12">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Filas" />
                    <TextField fx:id="txtSalaFilas" promptText="6" styleClass="form-input" />
                </VBox>
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Butacas por fila" />
                    <TextField fx:id="txtSalaColumnas" promptText="8" styleClass="form-input" />
                </VBox>
            </HBox>

            <Button fx:id="btnGenerarButacas" maxWidth="Infinity" styleClass="secondary-button" text="Generar butacas" onAction="#generarButacas" />

            <HBox spacing="10">
                <Button fx:id="btnGuardarSala" maxWidth="Infinity" styleClass="primary-button" text="+  Guardar sala" HBox.hgrow="ALWAYS" onAction="#guardarSala" />
                <Button fx:id="btnCancelarEdicionSala" maxWidth="Infinity" styleClass="secondary-button" text="Cancelar" HBox.hgrow="ALWAYS" onAction="#limpiarFormulario" />
            </HBox>
        </VBox>

        <!-- Las tarjetas de cada sala se generan por codigo en SalaControl
             (metodo cargarSalas), una por cada fila que haya en la tabla
             `sala`. Este contenedor arranca vacio. -->
        <VBox fx:id="salasListContainer" spacing="20" HBox.hgrow="ALWAYS" />
    </HBox>
</VBox>
