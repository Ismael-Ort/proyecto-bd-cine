<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Pagina: Funciones (tabla `funcion`).

    Campos: id_pelicula (combo), id_sala (combo), fecha_funcion (DatePicker),
    hora_inicio/hora_fin (un Spinner de hora + un Spinner de minuto cada
    una), tarifa_base, idioma_audio (obligatorio: toda funcion se pasa en
    algun idioma) e idioma_subtitulos (opcional: el checkbox
    chkFuncionTieneSubtitulos habilita el campo de texto solo si aplica).

    Estado: al crear siempre queda PROGRAMADA. El combo de Estado solo deja
    elegir PROGRAMADA/CANCELADA a mano -- EN_CURSO y FINALIZADA no tiene
    sentido asignarlos manualmente porque el trigger
    trg_actualizar_estado_funcion (ver database/procedimientos_triggers.sql)
    los recalcula solo, comparando la fecha/hora contra el reloj del
    servidor cada vez que FuncionBD.actualizarEstadosAutomaticos() se
    ejecuta (ver FuncionControl.cargarFunciones()).
-->

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cine.FuncionControl" spacing="24" styleClass="main-content" visible="false" managed="false">
    <padding>
        <Insets bottom="36" left="40" right="40" top="36" />
    </padding>

    <VBox spacing="4" styleClass="page-header">
        <Label styleClass="page-title" text="Funciones" />
        <Label styleClass="page-subtitle" text="Programacion de peliculas por sala y horario" />
    </VBox>

    <HBox alignment="TOP_LEFT" spacing="24" styleClass="funciones-layout">
        <VBox fx:id="funcionForm" maxWidth="340" minWidth="320" spacing="16" styleClass="form-card" HBox.hgrow="NEVER">
            <Label fx:id="lblFuncionFormTitulo" styleClass="panel-title" text="Nueva funcion" />

            <VBox spacing="8">
                <Label styleClass="form-label" text="Pelicula" />
                <ComboBox fx:id="cmbFuncionPelicula" maxWidth="Infinity" promptText="Selecciona una pelicula" styleClass="form-input" />
            </VBox>

            <VBox spacing="8">
                <Label styleClass="form-label" text="Sala" />
                <ComboBox fx:id="cmbFuncionSala" maxWidth="Infinity" promptText="Selecciona una sala" styleClass="form-input" />
            </VBox>

            <VBox spacing="8">
                <Label styleClass="form-label" text="Fecha" />
                <DatePicker fx:id="dpFuncionFecha" maxWidth="Infinity" styleClass="form-input" />
            </VBox>

            <HBox spacing="12">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Hora de inicio" />
                    <HBox spacing="6">
                        <Spinner fx:id="spnFuncionHoraInicioHora" prefWidth="80" styleClass="form-input" />
                        <Spinner fx:id="spnFuncionHoraInicioMinuto" prefWidth="80" styleClass="form-input" />
                    </HBox>
                </VBox>
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Hora de fin" />
                    <HBox spacing="6">
                        <Spinner fx:id="spnFuncionHoraFinHora" prefWidth="80" styleClass="form-input" />
                        <Spinner fx:id="spnFuncionHoraFinMinuto" prefWidth="80" styleClass="form-input" />
                    </HBox>
                </VBox>
            </HBox>

            <VBox spacing="8">
                <Label styleClass="form-label" text="Tarifa base (RD\$)" />
                <TextField fx:id="txtFuncionTarifa" promptText="45.00" styleClass="form-input" />
            </VBox>

            <VBox spacing="8">
                <Label styleClass="form-label" text="Idioma audio" />
                <TextField fx:id="txtFuncionIdiomaAudio" promptText="Espanol" styleClass="form-input" />
            </VBox>

            <VBox spacing="8">
                <CheckBox fx:id="chkFuncionTieneSubtitulos" styleClass="form-checkbox" text="Tiene subtitulos" onAction="#actualizarCampoSubtitulos" />
                <TextField fx:id="txtFuncionIdiomaSubtitulos" promptText="Ingles" styleClass="form-input" disable="true" />
            </VBox>

            <VBox spacing="8">
                <Label styleClass="form-label" text="Estado" />
                <ComboBox fx:id="cmbFuncionEstado" maxWidth="Infinity" styleClass="form-input">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="PROGRAMADA" />
                            <String fx:value="CANCELADA" />
                        </FXCollections>
                    </items>
                </ComboBox>
                <Label styleClass="form-hint" text="EN_CURSO y FINALIZADA se calculan solas segun la fecha/hora." wrapText="true" />
            </VBox>

            <HBox spacing="10">
                <Button fx:id="btnGuardarFuncion" maxWidth="Infinity" styleClass="primary-button" text="+  Guardar funcion" HBox.hgrow="ALWAYS" onAction="#guardarFuncion" />
                <Button fx:id="btnCancelarEdicionFuncion" maxWidth="Infinity" styleClass="secondary-button" text="Cancelar" HBox.hgrow="ALWAYS" onAction="#limpiarFormulario" />
            </HBox>
        </VBox>

        <VBox fx:id="panelFuncionesLista" spacing="18" styleClass="panel-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="panel-header">
                <Label styleClass="panel-icon" text="F" />
                <Label styleClass="panel-title" text="Funciones programadas" />
                <Region HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="cmbFuncionFiltroEstado" promptText="Filtrar por estado" styleClass="form-input" />
            </HBox>
            <!-- Las filas de cada funcion se generan por codigo en
                 FuncionControl (metodo cargarFunciones), una por cada fila
                 que haya en la tabla `funcion`. Este contenedor arranca vacio. -->
            <VBox fx:id="funcionesListaContainer" spacing="0" styleClass="list-container" />
        </VBox>
    </HBox>
</VBox>
