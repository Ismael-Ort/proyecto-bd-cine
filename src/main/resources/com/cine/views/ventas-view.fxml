<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Pagina: Ventas (tablas `venta` y `entrada`).

    "Registrar venta" llama a sp_registrar_venta; "Confirmar pago" llama a
    sp_confirmar_pago; "Cancelar" es un UPDATE simple (no hay procedimiento
    para eso). Ver docs/procedimientos_bd.md.

    El canal (TAQUILLA/EN_LINEA) y el empleado NUNCA se eligen a mano: los
    decide VentaControl segun quien inicio sesion (sesion.SesionActual). Si
    es un Cliente, tampoco se elige a que cliente venderle (es el mismo que
    inicio sesion) — por eso "filaClienteVenta" se oculta completa para ese
    rol, y solo Administrador/Cajero la ven para elegir a quien le venden.

    ventaSeatGridContainer y ventasListaContainer arrancan vacios: los llena
    VentaControl por codigo (mismo patron que FuncionControl/ClienteControl).

    BR-19: se pueden marcar varias butacas a la vez en ventaSeatGridContainer
    (no usan ToggleGroup) para comprarlas juntas en una sola venta.
-->


<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="24" styleClass="main-content" visible="false" managed="false" fx:controller="com.cine.VentaControl">
    <padding>
        <Insets bottom="36" left="40" right="40" top="36" />
    </padding>

    <VBox spacing="4" styleClass="page-header">
        <Label styleClass="page-title" text="Ventas" />
        <Label styleClass="page-subtitle" text="Registro de entradas, pagos y estados de venta" />
    </VBox>

    <HBox alignment="TOP_LEFT" spacing="24" styleClass="ventas-layout">

        <VBox fx:id="ventaForm" maxWidth="340" minWidth="320" spacing="16" styleClass="form-card" HBox.hgrow="NEVER">
            <Label styleClass="panel-title" text="Nueva venta" />

            <VBox fx:id="filaClienteVenta" spacing="8">
                <Label styleClass="form-label" text="Cliente" />
                <ComboBox fx:id="cmbVentaCliente" maxWidth="Infinity" promptText="Selecciona un cliente" styleClass="form-input" />
            </VBox>

            <VBox spacing="8">
                <Label styleClass="form-label" text="Metodo de pago" />
                <ComboBox fx:id="cmbVentaMetodoPago" maxWidth="Infinity" promptText="Selecciona un metodo de pago" styleClass="form-input" />
            </VBox>

            <VBox spacing="8">
                <Label styleClass="form-label" text="Observacion" />
                <TextArea fx:id="txtVentaObservacion" prefRowCount="2" promptText="Opcional" styleClass="form-textarea" wrapText="true" />
            </VBox>

            <Separator />

            <Label styleClass="panel-title" text="Butaca" />

            <VBox spacing="8">
                <Label styleClass="form-label" text="Funcion" />
                <ComboBox fx:id="cmbVentaFuncion" maxWidth="Infinity" promptText="Pelicula - sala - horario" styleClass="form-input" />
            </VBox>

            <VBox spacing="8">
                <Label styleClass="form-label" text="Tipo de entrada de la proxima butaca" />
                <ComboBox fx:id="cmbVentaTipoEntrada" maxWidth="Infinity" promptText="Selecciona un tipo de entrada" styleClass="form-input" />
                <Label styleClass="form-hint" text="Elige el tipo aqui y luego toca la butaca: puedes repetir esto con un tipo distinto para cada butaca (ej. una familia con entradas de Adulto y de Nino)." wrapText="true" />
            </VBox>

            <VBox spacing="8">
                <Label styleClass="form-label" text="Butacas seleccionadas" />
                <VBox fx:id="ventaSeatGridContainer" alignment="CENTER" spacing="8" styleClass="seat-grid, seat-grid-compact" />
            </VBox>

            <Button fx:id="btnRegistrarVenta" maxWidth="Infinity" onAction="#registrarVenta" styleClass="primary-button" text="+  Registrar venta" />
        </VBox>

        <VBox spacing="20" HBox.hgrow="ALWAYS">
            <VBox fx:id="panelUltimaVenta" spacing="10" styleClass="panel-card">
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="panel-header">
                    <Label styleClass="panel-icon" text="\$" />
                    <Label styleClass="panel-title" text="Ultima venta registrada" />
                </HBox>
                <Label fx:id="lblUltimaVentaResumen" styleClass="form-hint" text="Aun no se ha registrado ninguna venta en esta sesion." wrapText="true" />
            </VBox>

            <VBox fx:id="panelVentasLista" spacing="18" styleClass="panel-card" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="panel-header">
                    <Label styleClass="panel-icon" text="\$" />
                    <Label styleClass="panel-title" text="Ventas registradas" />
                    <Region HBox.hgrow="ALWAYS" />
                    <ComboBox fx:id="cmbVentaFiltroEstado" onAction="#aplicarFiltroEstado" promptText="Filtrar por estado" styleClass="form-input">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="TODOS" />
                                <String fx:value="PENDIENTE" />
                                <String fx:value="COMPLETADA" />
                                <String fx:value="CANCELADA" />
                            </FXCollections>
                        </items>
                    </ComboBox>
                </HBox>
                <VBox fx:id="ventasListaContainer" spacing="0" styleClass="list-container" />
            </VBox>
        </VBox>
    </HBox>
</VBox>
